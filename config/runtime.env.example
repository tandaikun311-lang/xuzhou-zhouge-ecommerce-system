# 首次部署前生成独立随机值，不要把真实 runtime.env 提交到 Git。
TAN_ADMIN_KEY=replace-with-a-strong-admin-password
TAN_EMP_KEY=replace-with-a-random-internal-employee-key
TAN_VISITOR_KEY=replace-with-a-random-disabled-visitor-key
TAN_PII_KEY=replace-with-a-separate-random-pii-key
TAN_SESSION_SECRET=replace-with-at-least-32-random-bytes

# 替换为实际 HTTPS 域名；多个域名用英文逗号分隔。
TEAM13_ALLOWED_ORIGINS=https://your-domain.example

# 默认值与原始徐州舟格部署一致；复制系统时可以改成新的独立路径。
TEAM13_DB_PATH=/opt/team13-board/board.db
TEAM13_UPLOAD_DIR=/www/wwwroot/default-site/zb-t1365d2f4f3/_uploads
TEAM13_UPLOAD_URL_PREFIX=/zb-t1365d2f4f3/_uploads

# 常驻服务必须保持 0。首次建库使用 README 中的单进程初始化命令临时覆盖为 1。
TEAM13_ALLOW_SCHEMA_MIGRATION=0
